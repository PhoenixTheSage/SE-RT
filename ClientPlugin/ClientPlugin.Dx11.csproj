<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>SERT</RootNamespace>
    <AssemblyName>SERT.Dx11</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Rendering\SoftwareDx11.cs" />
    <Compile Include="Rendering\GpuResources.cs" />
    <Compile Include="Rendering\GpuTimer.cs" />
    <Compile Include="Rendering\ShaderAbi.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="ClientPlugin.csproj" AdditionalProperties="SkipDx11Satellite=true;RunPostBuildEvent=Never" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="SharpDX">
      <HintPath>$(Bin64Dir)SharpDX.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX.Direct3D11">
      <HintPath>$(Bin64Dir)SharpDX.Direct3D11.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX.DXGI">
      <HintPath>$(Bin64Dir)SharpDX.DXGI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharpDX.D3DCompiler">
      <HintPath>$(Bin64Dir)SharpDX.D3DCompiler.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyBesidePlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildThisFileDirectory)bin\$(Configuration)\SERT.Dx11.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\SERT.Dx11.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
